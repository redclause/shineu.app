{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ShineU",
  "version": "0.1.0",
  "identifier": "com.shineu.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "ShineU — Influence OS",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "dmg", "app", "deb", "rpm"],
    "category": "Business",
    "shortDescription": "Free creator and influence marketing workspace",
    "longDescription": "ShineU is a free, local-first creator and influence marketing workspace for discovery, relationships, campaigns, content approvals, payments, analytics and reports.",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
